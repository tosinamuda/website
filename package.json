{
  "name": "tosinamuda-website",
  "version": "2.0.0",
  "description": "A durable, writer-first static website built with hand-authored HTML, Web Components, and plain CSS. Assembled by a small Node build script.",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node build.js",
    "dev": "node --watch build.js",
    "preview": "npx --yes sirv-cli dist --port 4173 --no-clear --host 127.0.0.1 --dev",
    "test": "npm run build",
    "lint:prose": "vale --no-exit content/blog",
    "lint:read": "python3 scripts/readability.py content/blog/*.html",
    "lint:spine": "python3 scripts/readability.py --spine"
  },
  "keywords": [
    "static-site",
    "web-components",
    "writing"
  ],
  "author": "Tosin Amuda",
  "license": "ISC",
  "type": "module"
}
